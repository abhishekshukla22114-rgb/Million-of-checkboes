# Application
NODE_ENV=production
PORT=5000

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=checkboxes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis/Valkey
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Checkbox Configuration
TOTAL_CHECKBOXES=1000000
CHECKBOX_BITMAP_KEY=checkboxes:bitmap:v1
PUB_SUB_CHANNEL=checkboxes:batch:stream

# Rate Limiting
USER_RATE_LIMIT_MS=200
BATCH_FLUSH_INTERVAL_MS=50

# CORS
CORS_ORIGIN=http://localhost:5000,http://localhost:3000