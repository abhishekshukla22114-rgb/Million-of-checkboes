# Application
NODE_ENV=production
PORT=5000

# PostgreSQL Database (Agar local testing hai to localhost, cloud/Render par Neon/Aiven ka connection string)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=checkboxes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Upstash Redis (Yahan TCP tab se mila URL paste karein)
REDIS_URL=rediss://default:gQAAAAAAAmNWAAIgcDFhNDYwYWNkMTk3MDA0N2MyOTU3ODA5YWU2MzQxNTY2NQ@peaceful-mayfly-156502.upstash.io:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Checkbox Configuration
TOTAL_CHECKBOXES=1000000
CHECKBOX_BITMAP_KEY=checkboxes:bitmap:v1
PUB_SUB_CHANNEL=checkboxes:batch:stream

# Rate Limiting
USER_RATE_LIMIT_MS=200
BATCH_FLUSH_INTERVAL_MS=50

# CORS
CORS_ORIGIN=*