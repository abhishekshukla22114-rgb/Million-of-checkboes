# Production Environment Variables
# Copy this to .env and update values for production deployment

# Application
NODE_ENV=production
PORT=5000

# PostgreSQL Database (REQUIRED for production)
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=checkboxes
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-secure-db-password

# Redis/Valkey (REQUIRED for production)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# JWT Authentication (REQUIRED - use strong secret in production!)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Checkbox Configuration
TOTAL_CHECKBOXES=1000000
CHECKBOX_BITMAP_KEY=checkboxes:bitmap:v1
PUB_SUB_CHANNEL=checkboxes:batch:stream

# Rate Limiting
USER_RATE_LIMIT_MS=200
BATCH_FLUSH_INTERVAL_MS=50

# CORS (set to your production domain)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Security
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true